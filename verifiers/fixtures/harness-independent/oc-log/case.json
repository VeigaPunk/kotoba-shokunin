{
 "name": "oc-log",
 "build": {
  "template_body": " now.\n\nSkill: {{name}}\n",
  "skills": {
   "alpha": {"name": "alpha", "style": "plain", "description": "Use alpha briefly."}
  },
  "db_rows": [
   {"live": "alpha"}
  ],
  "oc_log": "run=aaa message=\"skills rescanned\" skills=\"[\\\"alpha\\\",\\\"beta\\\"]\"\nrun=aaa message=\"skills rescanned\" skills=\"[\\\"alpha\\\"]\"\nrun=bbb message=\"cli starting\"\n",
  "config": {"theme": "system"}
 },
 "mutations": [
  {"name": "rescan-widened", "op": "log-append", "line": "run=aaa message=\"skills rescanned\" skills=\"[\\\"a\\\",\\\"b\\\",\\\"c\\\"]\"", "expect_check": "oc.log.skills_rescan_max"},
  {"name": "init-count-once", "op": "log-append", "line": "run=ccc message=\"init count\" value=1", "expect_check": "oc.log.init_count_max"},
  {"name": "init-count-twice", "op": "log-append", "lines": ["run=ddd message=\"init count\" value=2", "run=ddd message=\"init count\" value=3"], "expect_check": "oc.log.init_count_monotone"},
  {"name": "available-skills-tag", "op": "log-append", "line": "run=eee message=\"prompt rendered\" tag=<available_skills>", "expect_check": "oc.log.available_skills_hits"},
  {"name": "dup-both-sided", "op": "log-append", "lines": ["message=\"duplicate skill name\" existing=/home/USER/.agents/skills/alpha/SKILL.md duplicate=/home/USER/.claude/skills/alpha/SKILL.md", "message=\"duplicate skill name\" existing=/home/USER/.claude/skills/alpha/SKILL.md duplicate=/home/USER/.agents/skills/alpha/SKILL.md"], "expect_check": "oc.dup.roots_both_sided"},
  {"name": "tag-hit-added", "op": "log-append", "line": "run=fff message=\"prompt rendered\" tag=<skills>", "expect_check": "oc.log.skills_tag_hits"}
 ]
}