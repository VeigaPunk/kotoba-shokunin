+# Round 81 (repair 2, Q75): a hex token is external only by committed evidence.
+def external_binding(hex_id: str, repo: Path) -> bool:
+    """A hash absent from lane and fleet is external only by committed evidence.
+
+    `verifiers/external-commits.json` at HEAD lists `{hash, repository, receipt,
+    receipt_sha256}`: the third repository plus the fetch/ls-remote receipt whose
+    committed bytes carry that digest. Manifest and receipt are read at HEAD; the
+    receipt must also NAME the repository it is evidence for, and a hash that is
+    abbreviated (not exactly 40 lowercase hex) or claimed twice with conflicting
+    evidence drops out -- fail closed. A marker on the citing line is never read
+    (round-80 W8/W9)."""
+    try:
+        entries = json.loads(git_blob_bytes(repo, f"HEAD:{EXTERNAL_MANIFEST}") or b"{}")["commits"]
+    except (ValueError, KeyError, TypeError):
+        return False
+    claims = {(e.get("repository"), e.get("receipt"), e.get("receipt_sha256"))
+              for e in entries if isinstance(e, dict)
+              and e.get("hash") == hex_id.lower() and HASH40_RE.match(str(e.get("hash")))}
+    if len(claims) != 1:  # absent, abbreviated, or a conflicting duplicate
+        return False
+    repository, receipt, pinned = claims.pop()
+    if not isinstance(repository, str) or not REPO_ID_RE.match(repository):
+        return False
+    if not isinstance(pinned, str) or not SHA256_RE.match(pinned):
+        return False
+    if not isinstance(receipt, str) or not receipt or receipt.startswith("/") \
+            or ".." in receipt.split("/"):
+        return False
+    proof = git_blob_bytes(repo, f"HEAD:{receipt}")
+    return (proof is not None and hashlib.sha256(proof).hexdigest() == pinned
+            and repository.encode() in proof)
+
