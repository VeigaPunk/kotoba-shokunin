}

/* Anthropic Serif Display - for headlines */
@font-face {
  font-family: "Anthropic Serif Display";
  src: url("https://assets.claude.ai/Fonts/AnthropicSerif-Display-Regular-Static.otf") format("opentype");
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

