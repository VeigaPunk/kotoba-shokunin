2]] : m[2]\n    if (!Object.prototype.hasOwnProperty.call(MOVED, here)) return\n    var table = MOVED[here]\n    var hash = window.location.hash\n    if (!hash || hash.length \u003c 2) return\n    var id\n    try {\n      id = decodeURIComponent(hash.slice(1))\n    } catch (e) {\n      id = hash.slice(1)\n    }\n    if (document.getElementById(id)) return\n    if (!Object.prototype.hasOwnProperty.call(table, id)) return\n    var target = table[id]\n    if (typeof target !== 'string') return\n    var cut = target.indexOf('#')\n    var page = cut === -1 ? target : target.slice(0, cut)\n    var frag = cut === -1 ? '' : target.slice(cut)\n    if (page === here \u0026\u0026 !frag) {\n      // The content stayed on this page but lost its anchor: drop the dead\n      // hash so the address bar doesn't carry it, and stay put.\n      history.replaceState(null, '', window.location.pathname + window.location.search)\n      return\n    }\n    var dest = new URL(m[1] + page + window.location.search + frag, window.location.origin)\n    if (dest.origin !== window.location.origin) return\n    window.location.replace(dest.pathname + dest.search + dest.hash)\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', forward)\n  } else {\n    forward()\n  }\n  // A hash-only change on an already loaded page doesn't reload it, so\n  // check again when the fragment changes.\n  window.addEventListener('hashchange', forward)\n})()\n"])</script><script>self.__next_f.push([1,"6c:T992,"])</script><script>self.__next_f.push([1,"/**\n * Let a mouse click on a top-nav tab that has a dropdown go to the tab's\n * first page.\n *\n * Mintlify renders a tab with a \"menu\" in docs.json as a button with no link:\n * hovering opens the dropdown, and clicking only toggles it. Readers expect\n * the click to open the section, as it does on a tab that is a plain link.\n *\n * - A plain click follows the dropdown's first item.\n * - Cmd-click, Ctrl-click, and middle-click open that item in a new browser tab.\n * - Shift-click and Alt-click are left alone.\n *\n * The first item's link exists only while the dropdown is open. Hover has\n * usually opened it by the time a mouse can click. When it hasn't, for example\n * after Esc closed it under a resting pointer, the press opens it and this\n * waits briefly for the link.\n *\n * Mouse only. On touch and keyboard, pressing the tab is the only way to open\n * the dropdown, so those keep the default behavior.\n *\n * If the markup changes and any lookup here fails, the handler gives up and\n * the tab behaves as it does without this script.\n */\n;(function () {\n  if (typeof window === 'undefined' || typeof document === 'undefined') return\n\n  function firstLink(tab) {\n    var menuId = tab.getAttribute('aria-controls')\n    var menu = menuId \u0026\u0026 document.getElementById(menuId)\n    return menu \u0026\u0026 menu.querySelector('a[href]')\n  }\n\n  function follow(link, newTab) {\n    if (newTab) window.open(link.href, '_blank', 'noopener')\n    // Clicking the item itself keeps Mintlify's client-side navigation.\n    else link.click()\n  }\n\n  document.addEventListener(\n    'pointerdown',\n    function (event) {\n      if (event.pointerType !== 'mouse' || event.button \u003e 1) return\n      if (event.shiftKey || event.altKey) return\n      var newTab = event.button === 1 || event.metaKey || event.ctrlKey\n\n      var target = event.target\n      if (!target || !target.closest) return\n      var tab = target.closest('.nav-tabs button.nav-tabs-item[aria-haspopup=\"menu\"]')\n      if (!tab) return\n\n      var link = firstLink(tab)\n      if (link) {\n        event.preventDefault()\n        event.stopPropagation()\n        follow(link, newTab)\n        return\n      }\n\n      // Closed: let the press open the dropdown, then follow its first item.\n      var tries = 0\n      ;(function wait() {\n        var opened = firstLink(tab)\n        if (opened) follow(opened, newTab)\n        else if (++tries \u003c 30) window.requestAnimationFrame(wait)\n      })()\n    },\n    true\n  )\n})()\n"])</script><script>self.__next_f.push([1,"60:[\"$\",\"$L67\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"69bdb9fd7ba705a281409ac4\",\"filePath\":\"consent-loader.js\",\"subdomain\":\"claude-code\",\"__v\":0,\"content\":\"/**\\n * Consent banner loader for code.claude.com/docs.\\n *\\n * Mintlify auto-includes any .js file in the content root on every page.\\n * This loader injects the shared consent banner hosted on claude.com.\\n */\\n;(function () {\\n  var s = document.createElement('script')\\n  s.src = 'https://claude.com/shared/consent-banner.js'\\n  s.async = true\\n  document.head.appendChild(s)\\n})()\\n\"},{\"_id\":\"69fe40dc388017ee55c19b7a\",\"subdomain\":\"claude-code\",\"filePath\":\"antalytics-loader.js\",\"__v\":0,\"content\":\"$68\"},{\"_id\":\"6a567ad87ec0f756509df168\",\"filePath\":\"toc-collapse.js\",\"subdomain\":\"claude-code\",\"__v\":0,\"content\":\"$69\"},{\"_id\":\"6aa02c7db3ae356e0552bde8\",\"filePath\":\"settings-anchor-redirect.js\",\"subdomain\":\"claude-code\",\"__v\":0,\"content\":\"$6a\"},{\"_id\":\"6ab5b5a6e81de3b1772a6cfe\",\"filePath\":\"plugins-anchor-redirect.js\",\"subdomain\":\"claude-code\",\"__v\":0,\"content\":\"$6b\"},{\"_id\":\"6ac85ea1aebf431ed140e413\",\"subdomain\":\"claude-code\",\"filePath\":\"nav-tab-click.js\",\"__v\":0,\"content\":\"$6c\"}]}]\n"])</script><script>self.__next_f.push([1,"6f:T1fbc3,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,code:`code`,li:`li`,p:`p`,pre:`pre`,span:`span`,strong:`strong`,ul:`ul`,..._provideComponents(),...props.components},{CodeBlock,CodeGroup,Heading,Note,Tab,Tabs}=_components;if(!CodeBlock)_missingMdxReference(`CodeBlock`,true);if(!CodeGroup)_missingMdxReference(`CodeGroup`,true);if(!Heading)_missingMdxReference(`Heading`,true);if(!Note)_missingMdxReference(`Note`,true);if(!Tab)_missingMdxReference(`Tab`,true);if(!Tabs)_missingMdxReference(`Tabs`,true);return _jsxs(_Fragment,{children:[_jsxs(_components.p,{children:[`Agent Skills extend Claude with specialized capabilities that Claude invokes when relevant. Skills are packaged as `,_jsx(_components.code,{children:`SKILL.md`}),` files containing instructions, descriptions, and optional supporting resources. This page also covers `,_jsx(_components.a,{href:`#commands-in-agent-sdk-sessions`,children:`commands in Agent SDK sessions`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`For more information about skills, including benefits, architecture, and authoring guidelines, see the `,_jsx(_components.a,{href:`https://platform.claude.com/docs/en/agents-and-tools/agent-skills/overview`,children:`Agent Skills overview`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`how-skills-work-with-the-agent-sdk`,children:`How skills work with the Agent SDK`}),`\n`,_jsx(_components.p,{children:`When using the Claude Agent SDK, skills are:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Defined as filesystem artifacts`}),`: you create each skill as a `,_jsx(_components.code,{children:`SKILL.md`}),` file in its own directory, such as `,_jsx(_components.code,{children:`.claude/skills/\u003cname\u003e/SKILL.md`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Loaded from filesystem`}),`: the SDK loads skills from the filesystem locations governed by `,_jsx(_components.code,{children:`settingSources`}),` (TypeScript) or `,_jsx(_components.code,{children:`setting_sources`}),` (Python)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Automatically discovered`}),`: once filesystem settings load, the SDK discovers skill metadata at startup from user and project directories, and loads the full content when Claude invokes the skill`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Model-invoked`}),`: Claude autonomously chooses when to use them based on context`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`User-invoked`}),`: you dispatch a skill directly by sending `,_jsx(_components.code,{children:`/\u003cname\u003e`}),` in a prompt. See `,_jsx(_components.a,{href:`#commands-in-agent-sdk-sessions`,children:`Commands in Agent SDK sessions`})]}),`\n`,_jsxs(_components.li,{children:[_jsxs(_components.strong,{children:[`Scoped via the `,_jsx(_components.code,{children:`skills`}),` option`]}),`: discovered skills are enabled by default. Pass a list of skill names, `,_jsx(_components.code,{children:`\"all\"`}),`, or `,_jsx(_components.code,{children:`[]`}),` to control which skills Claude can invoke`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Unlike subagents, which you can define in the `,_jsxs(_components.a,{href:`/en/agent-sdk/subagents#programmatic-definition-recommended`,children:[_jsx(_components.code,{children:`agents`}),` option`]}),`, you create skills as files on disk. The SDK doesn’t provide a programmatic API for registering them.`]}),`\n`,_jsx(Note,{children:_jsxs(_components.p,{children:[`Skills are discovered through the filesystem setting sources. With default `,_jsx(_components.code,{children:`query()`}),` options, the SDK loads user and project sources, so skills in `,_jsx(_components.code,{children:`~/.claude/skills/`}),`, `,_jsx(_components.code,{children:`\u003ccwd\u003e/.claude/skills/`}),`, and `,_jsx(_components.code,{children:`.claude/skills/`}),` in any parent directory of `,_jsx(_components.code,{children:`\u003ccwd\u003e`}),` up to the repository root are available. The project source also covers `,_jsx(_components.code,{children:`\u003cdir\u003e/.claude/skills/`}),` in each directory you pass through `,_jsx(_components.code,{children:`additionalDirectories`}),` (TypeScript) or `,_jsx(_components.code,{children:`add_dirs`}),` (Python), because the SDK passes those directories to Claude Code as `,_jsx(_components.a,{href:`/en/skills#skills-from-additional-directories`,children:_jsx(_components.code,{children:`--add-dir`})}),`. If you set `,_jsx(_components.code,{children:`settingSources`}),` explicitly, include `,_jsx(_components.code,{children:`'project'`}),` to keep project and added-directory skills and `,_jsx(_components.code,{children:`'user'`}),` to keep your personal skills, or use the `,_jsxs(_components.a,{href:`/en/agent-sdk/plugins`,children:[_jsx(_components.code,{children:`plugins`}),` option`]}),` to load skills from a specific path.`]})}),`\n`,_jsx(Heading,{level:`2`,id:`use-skills-with-the-agent-sdk`,children:`Use skills with the Agent SDK`}),`\n`,_jsxs(_components.p,{children:[`Set the `,_jsx(_components.code,{children:`skills`}),` option on `,_jsx(_components.code,{children:`query()`}),` to control which skills Claude can invoke in the session. When omitted, discovered skills are enabled and the Skill tool is available, matching CLI behavior. Pass `,_jsx(_components.code,{children:`\"all\"`}),` to let Claude invoke every discovered skill, a list of skill names to allow only those, or `,_jsx(_components.code,{children:`[]`}),` to let Claude invoke none.`]}),`\n`,_jsx(_components.p,{children:`For example, to let Claude invoke only two named skills:`}),`\n`,_jsxs(CodeGroup,{children:[_jsx(CodeBlock,{filename:`Python`,numberOfLines:`1`,language:`python`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`python`,children:_jsxs(_components.code,{language:`python`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`options `}),_jsx(_components.span,{style:{co