,` files:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Available commands: [\"clear\", \"compact\", \"context\", \"usage\", \"code-review\", \"verify\", \"security-check\", ...]`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsxs(_components.p,{children:[`A skill with `,_jsx(_components.a,{href:`/en/skills#control-who-invokes-a-skill`,children:_jsx(_components.code,{children:`user-invocable: false`})}),` in its frontmatter doesn’t appear in this list or in the `,_jsx(_components.code,{children:`skills`}),` array from `,_jsx(_components.a,{href:`#confirm-skills-loaded`,children:`Confirm skills loaded`}),`. Sessions that configure `,_jsx(_components.a,{href:`/en/agent-sdk/mcp`,children:`MCP servers`}),` can also expose `,_jsx(_components.a,{href:`/en/mcp#use-mcp-prompts-as-commands`,children:`MCP prompts as commands`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`dispatch-commands-by-name`,children:`Dispatch commands by name`}),`\n`,_jsxs(_components.p,{children:[`Send a command by including it in your prompt string, the same way you send regular text. Dispatch doesn’t depend on the `,_jsx(_components.code,{children:`skills`}),` option. Sending `,_jsx(_components.code,{children:`/\u003cname\u003e`}),` runs a user-invocable skill even when your `,_jsx(_components.code,{children:`skills`}),` list omits it. Commands that act on conversation history, such as `,_jsx(_components.code,{children:`/compact`}),`, need prior messages to work with.`]}),`\n`,_jsxs(_components.p,{children:[`A `,_jsx(_components.code,{children:`/\u003cname\u003e`}),` that matches neither a command in the session nor a built-in Claude Code command doesn’t fail the query. Claude Code sends the prompt to Claude as an ordinary message, with a note that the command didn’t run, so the query spends a model turn and returns Claude’s reply. Before v2.1.274, a `,_jsx(_components.code,{children:`/\u003cname\u003e`}),` that matched nothing returned `,_jsx(_components.code,{children:`Unknown command: /\u003cname\u003e`}),` as the result without a model turn.`]}),`\n`,_jsxs(_components.p,{children:[`A `,_jsx(_components.code,{children:`/\u003cname\u003e`}),` that matches a built-in Claude Code command that isn’t available in the session, such as `,_jsx(_components.code,{children:`/theme`}),`, returns `,_jsx(_components.code,{children:`/theme isn't available in this environment.`}),` as the result without a model turn.`]}),`\n`,_jsx(Note,{children:_jsxs(_components.p,{children:[`A command can hit the `,_jsx(_components.code,{children:`maxTurns`}),` / `,_jsx(_components.code,{children:`max_turns`}),` limit like any other prompt, ending the query with an error result instead of `,_jsx(_components.code,{children:`success`}),`. For the error-result contract, see `,_jsx(_components.a,{href:`/en/agent-sdk/agent-loop#handle-the-result`,children:`Handle the result`}),`. If your command might hit the limit, wrap the loop in a `,_jsx(_components.code,{children:`try`}),`/`,_jsx(_components.code,{children:`catch`}),` in TypeScript or `,_jsx(_components.code,{children:`try`}),`/`,_jsx(_components.code,{children:`except`}),` in Python, as shown in `,_jsx(_components.a,{href:`/en/agent-sdk/streaming-vs-single-mode#single-message-input`,children:`Single Message Input`}),`, or set `,_jsx(_components.code,{children:`maxTurns`}),` high enough for the work to complete.`]})}),`\n`,_jsxs(Heading,{level:`3`,id:`compact-history-with-/compact`,children:[`Compact history with `,_jsx(_components.code,{children:`/compact`})]}),`\n`,_jsxs(_components.p,{children: