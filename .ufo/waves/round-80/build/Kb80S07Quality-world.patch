+def external_commit_marker(line: str, start: int) -> str:
+    """The third-repository owner/repo a `commit `<hex>`` citation on `line` names.
+
+    `start` is the citation match start (the word `commit`), so the attached and
+    token forms are read from the prefix that ends at it; the URL form names the
+    row's source repository anywhere on the line. Empty string = no marker: the
+    token is an in-set citation and keeps the exact pre-round-80 behavior.
+    """
+    prefix = line[:start]
+    for pattern in (EXTERNAL_REPO_AT_RE, EXTERNAL_REPO_TOKEN_RE):
+        match = pattern.search(prefix)
+        if match:
+            return match.group(1)
+    # The URL form is row-level, so it must name exactly ONE repository: a line
+    # naming two (or more) does not say which one the citation belongs to and
+    # fails closed -- the token stays in the in-set red path.
+    pairs = {m.group(1) for m in EXTERNAL_REPO_URL_RE.finditer(line)}
+    if len(pairs) == 1:
+        return next(iter(pairs))
+    return ""
+
