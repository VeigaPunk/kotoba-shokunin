+        shutil.rmtree(d, ignore_errors=True)
+        BASE_REV, SURFACES = saved_rev, saved_surfaces
+        _INTERNAL_SELFTEST = False
+        msg = f"{spec['label']}: exit 2"
+        if not all(checks):
+            msg += f" (want 2); output={out!r}"
+        return all(checks), len(checks), msg
+    cwd = os.getcwd()
+    buf = io.StringIO()
+    try:
