typewriter" style="font-size:80%;"> </span><span id="lstnumberx99.18" class="ltx_text ltx_font_typewriter" style="font-size:80%;">*</span><span id="lstnumberx99.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx99.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">sizeof</span><span id="lstnumberx99.21" class="ltx_text ltx_font_typewriter" style="font-size:80%;">(</span><span id="lstnumberx99.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">char</span><span id="lstnumberx99.23" class="ltx_text ltx_font_typewriter" style="font-size:80%;">),</span><span id="lstnumberx99.24" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx99.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">data</span><span id="lstnumberx99.26" class="ltx_text ltx_font_typewriter" style="font-size:80%;">[</span><span id="lstnumberx99.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">i</span><span id="lstnumberx99.28" class="ltx_text ltx_font_typewriter" style="font-size:80%;">]</span><span id="lstnumberx99.29" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx99.30" class="ltx_text ltx_font_typewriter" style="font-size:80%;">+</span><span id="lstnumberx99.31" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx99.32" class="ltx_text ltx_font_typewriter" style="font-size:80%;">8</span><span id="lstnumberx99.33" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx99.34" class="ltx_text ltx_font_typewriter" style="font-size:80%;">*</span><span id="lstnumberx99.35" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx99.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">sizeof</span><span id="lstnumberx99.37" class="ltx_text ltx_font_typewriter" style="font-size:80%;">(</span><span id="lstnumberx99.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">char</span><span id="lstnumberx99.39" class="ltx_text ltx_font_typewriter" style="font-size:80%;">);</span>
