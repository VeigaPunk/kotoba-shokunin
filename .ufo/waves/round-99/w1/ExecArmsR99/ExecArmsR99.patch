+            (c / "state" / "kote.report-baseline").write_text(
+                "9 " + "0" * 64 + "\n", encoding="utf-8")
+            return c
+
+        def _run_main(argv: list[str]) -> tuple[int, str, str]:
+            out_b, err_b = io.StringIO(), io.StringIO()
+            rc = None
+            try:
