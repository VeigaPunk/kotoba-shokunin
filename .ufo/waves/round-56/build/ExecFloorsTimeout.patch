+def child_timeout_s(base, load):
+    '''The per-child cap: `base` scaled by the host's 1-minute runnable count.
+
+    Round-56 routed defect 4: a flat base made this guard itself exit 2 on a
+    healthy tree under fleet load (round 55 measured the slowest child at
+    185-222 s against 120 s). Scaling up is the safe direction -- a cap that is
+    too generous only delays the report of a genuinely hung child, while a cap
+    that is too tight turns host load into a false could-not-evaluate. A load
+    of 1 or less (an idle host) leaves the base untouched; the factor is
+    clamped at SELF_TEST_TIMEOUT_MAX_SCALE.
+    '''
+    return base * min(max(1.0, load), SELF_TEST_TIMEOUT_MAX_SCALE)
 
