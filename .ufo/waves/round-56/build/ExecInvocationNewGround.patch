+def form_shape(token: str | None) -> str:
+    """v3: the form of a token -- its sigil, then the placeholder `<name>`.
+
+    The example name is not part of the form: `/skill-name`,
+    `/frontend-design` and `/<skill-name>` are the one form `/<name>`;
+    `$setup-demo-app` and `$<skill-name>` are `$<name>`; `@skill-id` is
+    `@<name>`."""
+    if not token:
+        return ""
+    m = TOKEN_RE.match(token)
+    return m.group(0)[0] + "<name>" if m else ""
+
+
+def base_form_count(form: str) -> int:
+    """v3: case-insensitive fixed-string count of `form` in the whole BASE tree.
+
+    `.ufo/` is excluded; SOURCES anchor/teaches cells, lessons and seat
+    reports are included.  `git grep` exit 1 means no hits (zero); any other
+    non-zero exit is could-not-evaluate."""
+    if not form:
+        return 0
+    try:
+        r = subprocess.run(["git", "-C", str(LANE), "grep", "-i", "-F", "-c", "-e", form,
+                            BASE, "--", ".", ":!.ufo"], capture_output=True)
+    except OSError as e:
+        raise EnvError("git not runnable: %s" % e) from e
+    if r.returncode == 1:
+        return 0
+    if r.returncode != 0:
+        raise EnvError("git grep %r %s failed: %s"
+                       % (form, BASE, r.stderr.decode(errors="replace").strip()))
+    total = 0
+    for line in r.stdout.decode("utf-8").splitlines():
+        _head, sep, tail = line.rpartition(":")
+        if sep and tail.isdigit():
+            total += int(tail)
+    return total
+
