+def cache_lookup(rows: dict[str, str], bare: str) -> tuple[str, str] | None:
+    """Resolve a bare content key in the store's two key spaces.
+
+    `skill-descriptions.ts` (18.12.5, read from the shipped chunk): a successful
+    compression is stored under the bare key `D({name, description})`; when the
+    model's output fails validation the preview is cached as
+    `<bare>:<provider>/<id>` ("keeping the preview for this model") so each
+    model retries independently and a failing model never masks a working one.
+    A bare-key-only reader therefore counts a served fallback as a miss.
+    """
+    if bare in rows:
+        return ("compressed", rows[bare])
+    prefix = bare + ":"
+    for key in rows:
+        if key.startswith(prefix):
+            return ("preview-fallback", rows[key])
+    return None
+
