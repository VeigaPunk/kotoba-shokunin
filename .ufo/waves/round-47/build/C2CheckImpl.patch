+def xml_tag_hits(desc: str) -> list[tuple[int, str]]:
+    """(0-based offset, token) of every XML tag in *desc*, left to right."""
+    return [(m.start(), m.group(0)) for m in XML_TAG_RE.finditer(desc)]
+
+
+def check_description_no_xml_tag(fm: tuple[dict | None, str]
+                                 ) -> tuple[str, int, str]:
+    fields, problem = fm
+    if fields is None:
+        return "FAIL", 0, "cannot evaluate: %s" % problem
+    desc = fields.get("description", "")
+    if not desc.strip():
+        return "FAIL", 0, "cannot evaluate: empty description:"
+    hits = xml_tag_hits(desc)
+    if hits:
+        named = "; ".join("%r at offset %d" % (tok, off) for off, tok in hits)
+        return "FAIL", 1, ("description carries XML tag%s %s (S003: the "
+                           "description cannot contain XML tags)"
+                           % ("s" if len(hits) > 1 else "", named))
+    return "PASS", 1, ("description carries no XML tag (%d chars scanned; "
+                       "S003)" % len(desc))
