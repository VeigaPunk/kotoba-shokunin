     "trigger.line_budget",
     "trigger.no_placeholder",
     "trigger.command_binary_resolves",
@@ -368,6 +388,24 @@ LINE_BOUND_BOX_RE = re.compile(
     r"file\b[^.\n]{0,40}?\d+[^.\n]{0,20}?lines?\b", re.IGNORECASE)
 INT_RE = re.compile(r"\d+")
 
+# round-47 C2 (S003, corpus/SOURCES.md): the description cannot contain XML
+# tags.  Names follow XML 1.0 (5th ed.) NameStartChar / NameChar.  A tag is an
+# end tag ``</Name S?>``, a start tag ``<Name (S Attr)* S?>`` or an
+# empty-element tag ``<Name (S Attr)* S?/>``; ``Attr`` is ``Name S? = S? "v"``
+# or ``'v'`` with ``v`` free of ``<`` and of its own quote (lenient on ``&``).
+XML_NAME_START = (r":A-Z_a-z\u00C0-\u00D6\u00D8-\u00F6\u00F8-\u02FF"
+                  r"\u0370-\u037D\u037F-\u1FFF\u200C-\u200D\u2070-\u218F"
+                  r"\u2C00-\u2FEF\u3001-\uD7FF\uF900-\uFDCF\uFDF0-\uFFFD"
+                  r"\U00010000-\U000EFFFF")
+XML_NAME_CHAR = XML_NAME_START + r"\-.0-9\u00B7\u0300-\u036F\u203F-\u2040"
+XML_NAME = "[%s][%s]*" % (XML_NAME_START, XML_NAME_CHAR)
+XML_WS = r"[ \t\r\n]"
+XML_ATTR = (XML_WS + "+" + XML_NAME + XML_WS + "*=" + XML_WS + "*"
+            + r"""(?:"[^"<]*"|'[^'<]*')""")
+XML_TAG_RE = re.compile(
+    "</" + XML_NAME + XML_WS + "*>"
+    + "|<" + XML_NAME + "(?:" + XML_ATTR + ")*" + XML_WS + "*/?>")
+
 
 class EnvError(Exception):
