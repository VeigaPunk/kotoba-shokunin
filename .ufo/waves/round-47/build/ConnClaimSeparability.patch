+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as exc:
+        return [], "errata registry unreadable: %s (%s)" % (path, exc)
+    if not isinstance(data, dict) or data.get("schema") != "kotoba-errata-v1":
+        return [], "errata registry schema is not 'kotoba-errata-v1': %s" % path
