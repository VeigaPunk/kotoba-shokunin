diff --git a/verifiers/check_mutation_battery.py b/verifiers/check_mutation_battery.py
index 25f5578..f240295 100755
--- a/verifiers/check_mutation_battery.py
+++ b/verifiers/check_mutation_battery.py
@@ -849,6 +849,25 @@ def self_test() -> int:
     finally:
         shutil.rmtree(root, ignore_errors=True)
         KILL_SET_PINNED = module_pin
+
+    _codes = {}
+    def _walk(co):
+        yield co
+        for _k in co.co_consts:
+            if hasattr(_k, "co_consts") and hasattr(_k, "co_code"):
+                yield from _walk(_k)
+    for _name, _val in list(globals().items()):
+        if hasattr(_val, "__code__"):
+            _codes[_name] = _val.__code__
+    def _flat(co):
+        return [k for c in _walk(co) for k in c.co_consts]
+    if "evaluate" in _codes:
+        _ev = _flat(_codes["evaluate"])
+        t.check("r95 forgery g1: n1 code-object const", "HEAD" not in _ev, "HEAD in evaluate consts")
+        t.check("r95 forgery g1: n5 code-object const",
+                not any(isinstance(x, str) and x.startswith("arm kill-set-size: manifest must") for x in _ev), "")
+    if "kill_set_check" in _codes:
+        t.check("r95 forgery g1: n11 code-object const", 2 not in _flat(_codes["kill_set_check"]), "2 in kill_set_check consts")
     for failure in t.failures:
         print("FAIL " + failure)
     print("%d failure(s) over %d assertions" % (len(t.failures), t.n))
