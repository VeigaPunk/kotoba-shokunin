  ```python
  def fetch(root: Path) -> tuple[int, list[str]]:
      """Re-open each cited URL and confirm its located quote is on the live page.

      One line per cited client: `S### <client>: found` / `NOT FOUND` / `FETCH FAILED <error>`.
      A fetch failure is never counted as a found quote and never crashes the counter.
      """
      results: list[str] = []
      entry_path = root / ENTRY
      sources_path = root / SOURCES
      if not entry_path.is_file():
          print(f"fetch: entry absent, nothing cited to fetch ({ENTRY})", file=sys.stderr)
          return 0, results
      if not sources_path.is_file():
          print(f"fetch: registry absent, cited ids cannot resolve ({SOURCES})", file=sys.stderr)
          return 0, results
      entry = entry_path.read_text(encoding="utf-8")
      rows = _source_rows(sources_path.read_text(encoding="utf-8"))
      src_lines = _entry_source_lines(entry)
      quotes = _quoted(_norm(entry))
      found = 0
      for sid, line in src_lines.items():
          row = rows.get(sid)
          if row is None:
              results.append(f"{sid}: NO ROW")
              continue
          client = _client_name(row)
          anchor = _norm(row[5]) if len(row) > 5 else ""
          quote = _located(line, quotes, anchor)
          if quote is None:
              results.append(f"{sid} {client}: NO LOCATED QUOTE")
              continue
          m = URL_RE.search(line) or (URL_RE.search(row[1]) if len(row) > 1 else None)
          if not m:
              results.append(f"{sid} {client}: NO URL")
              continue
          url = m.group(0)
          try:
              body = _http_get(url)
          except (FetchError, subprocess.TimeoutExpired, urllib.error.URLError, OSError, ValueError) as exc:
              results.append(f"{sid} {client}: FETCH FAILED {_tail(str(exc) or type(exc).__name__)}")
              continue
          if quote in _visible(body):
              found += 1
              results.append(f"{sid} {client}: found")
          else:
              results.append(f"{sid} {client}: NOT FOUND")
      return found, results
  ```

