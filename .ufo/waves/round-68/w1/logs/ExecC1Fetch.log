  ```python
  def _visible(body: str) -> str:
      """Whitespace-normalized searchable text: HTML is reduced to its visible text."""
      if HTML_RE.search(body[:8192]):
          t = re.sub(r"(?is)<(script|style)\b.*?</\1\s*>", " ", body)
          t = re.sub(r"(?s)<[^>]*>", " ", t)
          t = html_mod.unescape(t)
          return _norm(t)
      return _norm(body)
  ```

