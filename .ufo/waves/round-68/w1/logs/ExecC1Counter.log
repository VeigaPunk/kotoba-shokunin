  fetch:

  ```python
  def _live_page(url: str) -> str:
      req = urllib.request.Request(url, headers={"User-Agent": "kotoba-lane-counter/1.0"})
      with urllib.request.urlopen(req, timeout=FETCH_TIMEOUT) as resp:
          raw = resp.read(5_000_000)
      page = raw.decode(resp.headers.get_content_charset() or "utf-8", errors="replace")
      page = re.sub(r"(?is)<(script|style)\b.*?</\1>", " ", page)
      page = re.sub(r"(?s)<[^>]+>", " ", page)
      return html.unescape(page)


  def fetch_report(state) -> tuple[int, list[str]]:
      lines = []
      if state.get(ENTRY) is None or state.get(SOURCES) is None:
          return 0, ["--fetch: skipped — the entry or the registry is absent at the measured revision"]
      src_lines = _entry_source_lines(state[ENTRY])
      rows = _source_rows(state[SOURCES])
      quotes = _quoted(_norm(state[ENTRY]))
      if not src_lines:
          return 0, ["--fetch: skipped — no `source:` ids to fetch"]
      found = 0
      for sid, line_text in src_lines.items():
          row = rows.get(sid)
          if row is None:
              lines.append(f"--fetch {sid}: no row — url unknown, not fetched")
              continue
          m = URL_RE.search(row[1])
          if not m:
              lines.append(f"--fetch {sid}: the row's source cell carries no URL — not fetched")
              continue
          url = m.group(0).rstrip('.,;:)\]}"\'')
          sid_quotes = [q for q in quotes if q in _norm(row[5])] or quotes
          try:
              page = _norm(_live_page(url))
          except Exception as exc:  # network failure: reported, never counted
              lines.append(f"--fetch {sid}: unreachable ({type(exc).__name__}: {exc}) <{url}>")
              continue
          if any(q in page for q in sid_quotes):
              found += 1
              lines.append(f"--fetch {sid}: quote found <{url}>")
          else:
              lines.append(f"--fetch {sid}: quote NOT found on the live page <{url}>")
      lines.insert(0, f"--fetch: quotes located on live pages: {found} of {len(src_lines)}")
      return found, lines
  ```

