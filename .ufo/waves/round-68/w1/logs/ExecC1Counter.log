  ```python
  def _default_repo() -> Path:
      here = Path(__file__).resolve()
      for cand in here.parents:
          if (cand / "corpus" / "SOURCES.md").is_file():
              return cand
      return Path.cwd()


  def main(argv=None) -> int:
      ap = argparse.ArgumentParser(add_help=True)
      ap.add_argument("--rev", default=None, help="measured revision (full sha)")
      ap.add_argument("--repo", default=None, help="lane root (default: nearest ancestor holding corpus/SOURCES.md)")
      ap.add_argument("--fetch", action="store_true", help="also re-open each cited URL and locate its quote on the live page")
      ap.add_argument("--self-test", action="store_true")
      args = ap.parse_args(argv)
      repo = Path(args.repo) if args.repo else _default_repo()
      if args.self_test:
          return selftest(repo)
      try:
          state = _load(repo, args.rev)
          n, findings = check(state)
      except EnvError as exc:
          print(f"environment error: {exc}", file=sys.stderr)
          return 2
