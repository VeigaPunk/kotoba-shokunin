  ```python
  import subprocess, json, hashlib, sys, os
  from pathlib import Path
  lane = Path("/tmp/mut68/lane")
  res = Path("/tmp/mut68/results")
  def sh(*a, **k): return subprocess.run(a, capture_output=True, text=True, **k)
  def git(*a): 
      p = sh("git","-C",str(lane),*a)
      assert p.returncode==0, (a, p.stderr)
      return p.stdout.strip()
  HEAD = git("rev-parse","HEAD")
  def run(label, rev):
      p = subprocess.run(["python3","-B","/tmp/mut68/variants/pinned.py","--repo",str(lane),"--rev",rev], capture_output=True, text=True)
      out = (p.stdout+p.stderr).strip()
      (res/f"M-{label}.txt").write_text(out)
      print(f"== M-{label} rev={rev[:12]} exit={p.returncode}")
      print(out)
      return p.returncode, out
  def commit_mut(label, edits):  # edits: {relpath: fn(text)->text}
      git("checkout","HEAD","--",".")
