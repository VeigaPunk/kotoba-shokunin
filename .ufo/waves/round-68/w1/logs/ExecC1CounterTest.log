  Selftest body:

  ```python
  def selftest() -> int:
      assertions = 0
      failures = 0

      def check(label: str, got, want) -> None:
          nonlocal assertions, failures
          assertions += 1
          if got != want:
              failures += 1
              print(f"FAIL {label}: got {got!r} want {want!r}")

      expected = {
          "entry-missing": 0,
          "no-source-line": 0,
          "id-does-not-resolve": 4,
          "row-not-mined": 4,
          "source-cell-absent": 4,
          "no-verified-at": 0,
          "no-recheck": 0,
          "no-coverage-row": 0,
          "quote-absent-from-anchor": 4,
          "client-name-absent": 4,
      }
      with tempfile.TemporaryDirectory(prefix="k68-selftest-") as tmp:
          scratch = Path(tmp)
          honest = _world(scratch / "honest", _honest_entry(), _honest_sources(), _honest_readme())
          n, findings = check(honest)
          check("honest/count", n, TOTAL)
          check("honest/findings-empty", findings, [])
          code, out, _ = _drive(["--repo", str(honest)])
          check("honest/main-exit", code, 0)
          check("honest/main-line", f"client trust gates backed {TOTAL} of {TOTAL}" in out, True)

          worlds = _broken_worlds(scratch, _honest_entry(), _honest_sources(), _honest_readme())
          for name, root in worlds.items():
              n, findings = check(root)
              check(f"{name}/count", n, expected[name])
              check(f"{name}/findings-nonempty", bool(findings), True)
              code, out, _ = _drive(["--repo", str(root)])
              check(f"{name}/main-exit", code, 1)
              check(f"{name}/main-line",
                    f"client trust gates backed {expected[name]} of {TOTAL}" in out, True)

          # (a) missing entry: a CONTENT verdict — exit 1, `0 of 5`, never exit 2.
          code, out, err = _drive(["--repo", str(worlds["entry-missing"])])
          check("class/missing-entry-exit", code, 1)
          check("class/missing-entry-line",
                f"client trust gates backed 0 of {TOTAL}" in out, True)
          check("class/missing-entry-no-env-error",
                "environment error" in out + err, False)

          # (b) unknown revision: an ENVIRONMENT error — exit 2, in a scratch repo.
          ...
      print(f"self-test: {failures} failure(s) over {assertions} assertions")
      return 1 if failures else 0
  ```

