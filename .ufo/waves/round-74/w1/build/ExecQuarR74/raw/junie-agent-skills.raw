<!DOCTYPE html SYSTEM "about:legacy-compat">
<html lang="en-US" data-preset="contrast" data-primary-color="#307FFF" data-link-color="#2F7FFF"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><meta charset="UTF-8"><meta name="built-on" content="2026-10-23T18:43:21.378432446"><title>Agent skills | Junie Documentation</title><script type="application/json" id="virtual-toc-data">[{"id":"why-agent-skills","level":0,"title":"Why agent skills?","anchor":"#why-agent-skills"},{"id":"what-you-can-do-with-skills","level":0,"title":"What you can do with skills","anchor":"#what-you-can-do-with-skills"},{"id":"how-junie-cli-uses-skills","level":0,"title":"How Junie CLI uses skills","anchor":"#how-junie-cli-uses-skills"},{"id":"skill-location","level":1,"title":"Skill location","anchor":"#skill-location"},{"id":"skill-directory-structure","level":1,"title":"Skill directory structure","anchor":"#skill-directory-structure"},{"id":"skill-md-format","level":1,"title":"SKILL.md format","anchor":"#skill-md-format"},{"id":"frontmatter-fields","level":2,"title":"Frontmatter fields","anchor":"#frontmatter-fields"},{"id":"body-content","level":2,"title":"Body content","anchor":"#body-content"},{"id":"manage-skills-with-skills","level":0,"title":"Manage skills with /skills","anchor":"#manage-skills-with-skills"},{"id":"skill-locations-and-configuration","level":0,"title":"Skill locations and configuration","anchor":"#skill-locations-and-configuration"},{"id":"adding-a-skill","level":0,"title":"Adding a skill","anchor":"#adding-a-skill"},{"id":"prompt-junie-to-add-a-skill","level":1,"title":"Prompt Junie to add a skill","anchor":"#prompt-junie-to-add-a-skill"},{"id":"create-your-own-skill","level":1,"title":"Create your own skill","anchor":"#create-your-own-skill"},{"id":"add-skills-from-public-repositories","level":1,"title":"Add skills from public repositories","anchor":"#add-skills-from-public-repositories"},{"id":"best-practices","level":0,"title":"Best practices","anchor":"#best-practices"},{"id":"troubleshooting","level":0,"title":"Troubleshooting","anchor":"#troubleshooting"},{"id":"example-skill-folder","level":0,"title":"Example skill folder","anchor":"#example-skill-folder"},{"id":"what-s-next","level":0,"title":"What\u0027s next","anchor":"#what-s-next"}]</script><script type="application/json" id="topic-shortcuts"></script><link href="https://resources.jetbrains.com/writerside/apidoc/6.26.0-b913/app.css" rel="stylesheet"><link href="static/custom.css" rel="stylesheet"><link rel="manifest" href="https://www.jetbrains.com/site.webmanifest"><meta name="msapplication-TileColor" content="#000000"><link rel="apple-touch-icon" sizes="180x180" href="https://jetbrains.com/apple-touch-icon.png"><link rel="icon" type="image/png" sizes="32x32" href="https://jetbrains.com/favicon-32x32.png"><link rel="icon" type="image/png" sizes="16x16" href="https://jetbrains.com/favicon-16x16.png"><meta name="msapplication-TileImage" content="https://resources.jetbrains.com/storage/ui/favicons/mstile-144x144.png"><meta name="msapplication-square70x70logo" content="https://resources.jetbrains.com/storage/ui/favicons/mstile-70x70.png"><meta name="msapplication-square150x150logo" content="https://resources.jetbrains.com/storage/ui/favicons/mstile-150x150.png"><meta name="msapplication-wide310x150logo" content="https://resources.jetbrains.com/storage/ui/favicons/mstile-310x150.png"><meta name="msapplication-square310x310logo" content="https://resources.jetbrains.com/storage/ui/favicons/mstile-310x310.png"><meta name="image" content="https://resources.jetbrains.com/storage/products/junie/img/meta/preview.png"><!-- Open Graph --><meta property="og:title" content="Agent skills | Junie"><meta property="og:description" content=""><meta property="og:image" content="https://resources.jetbrains.com/storage/products/junie/img/meta/preview.png"><meta property="og:site_name" content="Junie Help"><meta property="og:type" content="website"><meta property="og:locale" content="en_US"><meta property="og:url" content="https://www.jetbrains.com/help/junie/agent-skills.html"><!-- End Open Graph --><!-- Twitter Card --><meta name="twitter:card" content="summary_large_image"><meta name="twitter:site" content="@JetBrains"><meta name="twitter:title" content="Agent skills | Junie"><meta name="twitter:description" content=""><meta name="twitter:creator" content="@JetBrains"><meta name="twitter:image:src" content="https://resources.jetbrains.com/storage/products/junie/img/meta/preview.png"><!-- End Twitter Card --><!-- Schema.org WebPage --><script type="application/ld+json">{
